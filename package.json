{
  "name": "pocket-workbench",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "build": "tsc -b && vite build --mode pro",
    "preview": "vite preview",
    "test:vault": "node scripts/test-vault.mjs",
    "build:vault": "tsc -b && vite build --mode vault-lab --config vite.vault.config.ts",
    "test:vault:browsers": "node scripts/test-vault-browsers.cjs",
    "preview:vault": "vite preview --mode vault-lab --config vite.vault.config.ts --port 4177 --strictPort",
    "test:vault:page": "node scripts/test-vault-page.cjs",
    "vault:local": "node scripts/vault-local.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "6.2.3",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "5.18.0",
    "@mui/material": "5.18.0",
    "@uiw/react-md-editor": "4.1.0",
    "antd": "6.4.3",
    "axios": "1.20.0",
    "dayjs": "1.11.21",
    "hash-wasm": "4.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "react-syntax-highlighter": "16.1.1",
    "remark-gfm": "4.0.1",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-syntax-highlighter": "15.5.13",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "typescript": "6.0.3",
    "vite": "7.3.7"
  }
}
