# Example environment file
# Copy to .env.dev or .env.pro and fill in real values

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8080

# Build output directory
VITE_OUT_DIR=D:/project/forge/src/main/resources/static

# App title
VITE_APP_TITLE=Forge

# Enable only with backend F1/F2/F3 + SQL004-008 and completed pre-release checks.
# Default is false; controls preparation/local migration actions, not read-only status.
VITE_VAULT_MIGRATION_ENABLED=false
